# Catppuccin Mocha theme for mako
# reload with: systemctl --user restart mako

font=JetBrainsMono Nerd Font 11
width=360
height=120
margin=12
padding=12
border-size=2
border-radius=8
icons=1
max-icon-size=48
max-visible=5
anchor=top-right
layer=overlay
markup=1
default-timeout=5000
ignore-timeout=0

background-color=#1e1e2e
text-color=#cdd6f4
border-color=#b4befe
progress-color=over #313244

[urgency=low]
border-color=#89b4fa

[urgency=normal]
border-color=#cba6f7

[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

# do-not-disturb mode: activated with `makoctl mode -t do-not-disturb`
# (Ctrl+. or Super+Shift+N in hyprland, or the waybar bell icon)
[mode=do-not-disturb]
invisible=1
