#!/usr/bin/env bash
# Waybar: screen brightness — sun that grows with the level, plus percentage.
set -uo pipefail
source ~/.config/waybar/scripts/lib.sh

cur=$(brightnessctl get 2>/dev/null) || cur=0
max=$(brightnessctl max 2>/dev/null) || max=1
(( max <= 0 )) && max=1
pct=$(( (cur * 100 + max / 2) / max ))

if   (( pct <= 25 )); then icon="󰖙"   # dim sun
elif (( pct <= 60 )); then icon="󰃟"   # half sun
else                       icon="󰖨"   # full sun
fi

wb_json "${icon} ${pct}%" "" \
        "Brightness ${pct}%\\nScroll to adjust"
