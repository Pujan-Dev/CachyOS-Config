#!/usr/bin/env bash
# Waybar: output volume — speaker whose waves grow with the level, plus percentage.
set -uo pipefail
source ~/.config/waybar/scripts/lib.sh

raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || raw=""
vol=${raw#Volume: }; vol=${vol%% *}
muted=""; case "$raw" in *MUTED*) muted="muted";; esac
pct=$(awk -v v="${vol:-0}" 'BEGIN{printf "%d", v*100+0.5}')

if   [ -n "$muted" ];  then icon="󰝟"
elif (( pct <= 33 ));  then icon="󰕿"
elif (( pct <= 66 ));  then icon="󰖀"
else                        icon="󰕾"
fi

wb_json "${icon} ${pct}%" "$muted" \
        "Volume ${pct}%\\nLeft-click: mixer  ·  Right-click: mute  ·  Scroll: volume"
